#!/usr/bin/env bash
#
# devdocker —— Docker/Podman 容器 & 镜像 & Compose & tmux & ollama 交互式工具箱
#
# 安装：
#   mkdir -p ~/.local/bin
#   cp devdocker ~/.local/bin/devdocker
#   chmod +x ~/.local/bin/devdocker
#
# 运行时自动检测：docker 优先，其次 podman
# Compose 自动检测：docker compose → docker-compose → podman compose → podman-compose
# tmux / ollama 自动检测（可选）

if [[ "${BASH_SOURCE[0]:-$0}" == "$0" ]]; then
  set -u
fi

# ---------------- 颜色 ----------------
if [[ -t 1 ]]; then
  RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'
  BLUE=$'\033[34m'; CYAN=$'\033[36m'; BOLD=$'\033[1m'; NC=$'\033[0m'
else
  RED=''; GREEN=''; YELLOW=''; BLUE=''; CYAN=''; BOLD=''; NC=''
fi

have() { command -v "$1" >/dev/null 2>&1; }
is_sourced() { [[ "${BASH_SOURCE[0]:-$0}" != "$0" ]]; }
hr() { printf '%s\n' "${CYAN}------------------------------------------------------------${NC}"; }

run() {
  printf '%s+ %s%s\n' "$BLUE" "$*" "$NC"
  "$@"
}

expand_tilde() {
  local p="$1"
  if [[ "$p" == "~" ]]; then
    printf '%s' "$HOME"
  elif [[ "$p" == "~/"* ]]; then
    printf '%s' "${HOME}/${p#\~/}"
  else
    printf '%s' "$p"
  fi
}

# ---------------- 运行时 / Compose / 外部工具检测 ----------------
RT=""
RT_NAME=""
COMPOSE=()
COMPOSE_NAME=""
TMUX_OK=""
OLLAMA_OK=""

detect_runtime() {
  RT=""; RT_NAME=""
  if have docker; then
    RT=docker; RT_NAME=docker
  elif have podman; then
    RT=podman; RT_NAME=podman
  fi
}

detect_compose() {
  COMPOSE=(); COMPOSE_NAME=""
  if have docker && docker compose version >/dev/null 2>&1; then
    COMPOSE=(docker compose);    COMPOSE_NAME="docker compose"
  elif have docker-compose; then
    COMPOSE=(docker-compose);    COMPOSE_NAME="docker-compose"
  elif have podman && podman compose version >/dev/null 2>&1; then
    COMPOSE=(podman compose);    COMPOSE_NAME="podman compose"
  elif have podman-compose; then
    COMPOSE=(podman-compose);    COMPOSE_NAME="podman-compose"
  fi
}

detect_extras() {
  TMUX_OK=""; OLLAMA_OK=""
  have tmux   && TMUX_OK=tmux
  have ollama && OLLAMA_OK=ollama
}

install_hint() {
  case "$1" in
    docker)         echo "  docker         : https://docs.docker.com/engine/install/ （或 sudo apt install docker.io）" ;;
    podman)         echo "  podman         : sudo apt install podman / sudo dnf install podman / brew install podman" ;;
    docker-compose) echo "  docker-compose : sudo apt install docker-compose / pip install docker-compose" ;;
    podman-compose) echo "  podman-compose : pip install podman-compose / sudo apt install podman-compose" ;;
    tmux)           echo "  tmux           : sudo apt install tmux / sudo dnf install tmux / brew install tmux" ;;
    ollama)         echo "  ollama         : curl -fsSL https://ollama.com/install.sh | sh （参考 https://ollama.com/download）" ;;
    *)              echo "  $1             : 请自行安装" ;;
  esac
}

need_rt() {
  if [[ -z "$RT" ]]; then
    echo "${RED}✗ 未检测到 docker 或 podman${NC}"
    install_hint docker
    install_hint podman
    return 1
  fi
  return 0
}

need_compose() {
  if (( ${#COMPOSE[@]} == 0 )); then
    echo "${RED}✗ 未检测到 compose 命令${NC}"
    install_hint docker-compose
    install_hint podman-compose
    return 1
  fi
  return 0
}

preflight_check() {
  detect_runtime
  detect_compose
  detect_extras
  echo
  if [[ -z "$RT" ]]; then
    echo "${YELLOW}⚠ 未检测到 docker 或 podman，容器/镜像功能不可用${NC}"
    install_hint docker
    install_hint podman
  else
    echo "${GREEN}✓ 容器运行时: ${RT_NAME}${NC}"
  fi
  if (( ${#COMPOSE[@]} == 0 )); then
    echo "${YELLOW}⚠ 未检测到 compose 命令，compose 功能不可用${NC}"
    install_hint docker-compose
    install_hint podman-compose
  else
    echo "${GREEN}✓ Compose 命令: ${COMPOSE_NAME}${NC}"
  fi
  if [[ -z "$TMUX_OK" ]]; then
    echo "${YELLOW}⚠ 未检测到 tmux，tmux 功能不可用${NC}"
    install_hint tmux
  else
    echo "${GREEN}✓ tmux: ${TMUX_OK}${NC}"
  fi
  if [[ -z "$OLLAMA_OK" ]]; then
    echo "${YELLOW}⚠ 未检测到 ollama，ollama 功能不可用${NC}"
    install_hint ollama
  else
    echo "${GREEN}✓ ollama: ${OLLAMA_OK}${NC}"
  fi
  echo
}

# ============================================================
# 一、容器相关操作
# ============================================================

do_ps() {
  need_rt || return 1
  local ans
  read -r -p "是否包含已停止的容器 -a? [y/N]: " ans
  if [[ "$ans" =~ ^[Yy]$ ]]; then
    run "$RT" ps -a
  else
    run "$RT" ps
  fi
}

do_run_keepalive() {
  need_rt || return 1
  local name image ports envs p e
  read -r -p "容器名（默认 test-debian）: " name
  name=${name:-test-debian}
  read -r -p "镜像（默认 debian:latest）: " image
  image=${image:-debian:latest}
  read -r -p "端口映射 -p（如 8080:80，多个用空格分隔，留空跳过）: " ports
  read -r -p "环境变量 -e（如 KEY=VALUE，多个用空格分隔，留空跳过）: " envs

  local -a cmd=("$RT" run -d --name "$name")
  for p in $ports; do cmd+=(-p "$p"); done
  for e in $envs;  do cmd+=(-e "$e"); done
  cmd+=("$image" sleep infinity)

  run "${cmd[@]}"
}

do_exec_cmd() {
  need_rt || return 1
  local cname cmdline
  read -r -p "容器名/ID（默认 test-debian）: " cname
  cname=${cname:-test-debian}
  read -r -p "要执行的命令（默认 mkdir -p /root/.local/share/devmgr/AI）: " cmdline
  cmdline=${cmdline:-mkdir -p /root/.local/share/devmgr/AI}
  # shellcheck disable=SC2086
  run "$RT" exec -it "$cname" $cmdline
}

do_exec_shell() {
  need_rt || return 1
  local cname shell
  read -r -p "容器名/ID（默认 test-debian）: " cname
  cname=${cname:-test-debian}
  read -r -p "Shell（默认 /bin/bash，失败自动尝试 /bin/sh）: " shell
  shell=${shell:-/bin/bash}
  if ! run "$RT" exec -it "$cname" "$shell"; then
    if [[ "$shell" != "/bin/sh" ]]; then
      echo "${YELLOW}尝试 /bin/sh ...${NC}"
      run "$RT" exec -it "$cname" /bin/sh
    fi
  fi
}

do_cp() {
  need_rt || return 1
  local dir lpath cpath
  echo "  1) 本地 → 容器"
  echo "  2) 容器 → 本地"
  read -r -p "方向 [1/2]（默认 1）: " dir
  dir=${dir:-1}

  read -r -p "本地路径（默认 ~/.local/share/devmgr/AI）: " lpath
  lpath=${lpath:-~/.local/share/devmgr/AI}
  lpath=$(expand_tilde "$lpath")

  read -r -p "容器侧路径（默认 test-debian:/root/.local/share/devmgr/AI）: " cpath
  cpath=${cpath:-test-debian:/root/.local/share/devmgr/AI}

  if [[ "$dir" == "2" ]]; then
    run "$RT" cp "$cpath" "$lpath"
  else
    run "$RT" cp "$lpath" "$cpath"
  fi
}

do_rm_force() {
  need_rt || return 1
  local names ans
  read -r -p "容器名/ID（多个用空格分隔）: " names
  [[ -z "$names" ]] && return 0
  read -r -p "强制删除 -f? [Y/n]: " ans
  if [[ "$ans" =~ ^[Nn]$ ]]; then
    run "$RT" rm $names
  else
    run "$RT" rm -f $names
  fi
}

do_start() {
  need_rt || return 1
  local names
  read -r -p "容器名/ID（多个用空格分隔）: " names
  [[ -z "$names" ]] && return 0
  run "$RT" start $names
}

do_stop() {
  need_rt || return 1
  local names
  read -r -p "容器名/ID（多个用空格分隔）: " names
  [[ -z "$names" ]] && return 0
  run "$RT" stop $names
}

do_restart() {
  need_rt || return 1
  local names
  read -r -p "容器名/ID（多个用空格分隔）: " names
  [[ -z "$names" ]] && return 0
  run "$RT" restart $names
}

do_network_ls() {
  need_rt || return 1
  run "$RT" network ls
}

do_network_inspect() {
  need_rt || return 1
  local net
  read -r -p "网络名/ID: " net
  [[ -z "$net" ]] && return 0
  run "$RT" network inspect "$net"
}

do_logs() {
  need_rt || return 1
  local cname ans
  read -r -p "容器名/ID: " cname
  [[ -z "$cname" ]] && return 0
  read -r -p "实时跟踪 -f? [y/N]: " ans
  if [[ "$ans" =~ ^[Yy]$ ]]; then
    run "$RT" logs -f "$cname"
  else
    run "$RT" logs "$cname"
  fi
}

do_top() {
  need_rt || return 1
  local cname
  read -r -p "容器名/ID: " cname
  [[ -z "$cname" ]] && return 0
  run "$RT" top "$cname"
}

# ============================================================
# 二、镜像相关操作
# ============================================================

do_build() {
  need_rt || return 1
  local tag ctx
  read -r -p "镜像名:标签（如 myapp:v1）: " tag
  [[ -z "$tag" ]] && return 0
  read -r -p "构建上下文 / Dockerfile 路径（默认 .）: " ctx
  ctx=${ctx:-.}
  ctx=$(expand_tilde "$ctx")
  run "$RT" build -t "$tag" "$ctx"
}

do_pull() {
  need_rt || return 1
  local image
  read -r -p "镜像名:标签: " image
  [[ -z "$image" ]] && return 0
  run "$RT" pull "$image"
}

do_push() {
  need_rt || return 1
  local image
  read -r -p "镜像名:标签: " image
  [[ -z "$image" ]] && return 0
  run "$RT" push "$image"
}

do_images() {
  need_rt || return 1
  run "$RT" images
}

do_rmi() {
  need_rt || return 1
  local images ans
  read -r -p "镜像ID/名称（多个用空格分隔）: " images
  [[ -z "$images" ]] && return 0
  read -r -p "强制删除 -f? [y/N]: " ans
  if [[ "$ans" =~ ^[Yy]$ ]]; then
    run "$RT" rmi -f $images
  else
    run "$RT" rmi $images
  fi
}

do_save() {
  need_rt || return 1
  local image file
  read -r -p "镜像名:标签: " image
  [[ -z "$image" ]] && return 0
  read -r -p "保存文件名（留空 = <image>.tar）: " file
  if [[ -z "$file" ]]; then
    file="${image//[:\/]/-}.tar"
  fi
  file=$(expand_tilde "$file")
  run "$RT" save -o "$file" "$image"
}

do_load() {
  need_rt || return 1
  local file
  read -r -p "tar 文件路径: " file
  [[ -z "$file" ]] && return 0
  file=$(expand_tilde "$file")
  run "$RT" load -i "$file"
}

# ============================================================
# 三、Compose 相关操作
# ============================================================

do_compose_start() {
  need_compose || return 1
  run "${COMPOSE[@]}" start
}

do_compose_stop() {
  need_compose || return 1
  run "${COMPOSE[@]}" stop
}

do_compose_restart() {
  need_compose || return 1
  run "${COMPOSE[@]}" restart
}

do_compose_up() {
  need_compose || return 1
  local mode
  echo "  1) 后台运行 -d"
  echo "  2) 前台运行（阻塞日志）"
  echo "  3) -d --force-recreate（强制重建）"
  echo "  4) -d --no-recreate（仅重建变化的）"
  read -r -p "请选择（默认 1）: " mode
  mode=${mode:-1}
  case "$mode" in
    2) run "${COMPOSE[@]}" up ;;
    3) run "${COMPOSE[@]}" up -d --force-recreate ;;
    4) run "${COMPOSE[@]}" up -d --no-recreate ;;
    *) run "${COMPOSE[@]}" up -d ;;
  esac
}

do_compose_down() {
  need_compose || return 1
  run "${COMPOSE[@]}" down
}

do_compose_ps() {
  need_compose || return 1
  run "${COMPOSE[@]}" ps
}

do_compose_rm() {
  need_compose || return 1
  local ans
  read -r -p "强制删除 -f? [y/N]: " ans
  if [[ "$ans" =~ ^[Yy]$ ]]; then
    run "${COMPOSE[@]}" rm -f
  else
    run "${COMPOSE[@]}" rm
  fi
}

do_compose_network_ls() {
  need_compose || return 1
  run "${COMPOSE[@]}" network ls
}

do_compose_logs() {
  need_compose || return 1
  local svc ans
  read -r -p "服务名（留空 = 全部服务）: " svc
  read -r -p "实时跟踪 -f? [y/N]: " ans
  local -a cmd=("${COMPOSE[@]}" logs)
  [[ -n "$svc" ]] && cmd+=("$svc")
  [[ "$ans" =~ ^[Yy]$ ]] && cmd+=(-f)
  run "${cmd[@]}"
}

# ============================================================
# 四、tmux 快捷操作
# ============================================================

need_tmux() {
  if [[ -z "$TMUX_OK" ]]; then
    echo "${RED}✗ 未检测到 tmux${NC}"
    install_hint tmux
    return 1
  fi
  return 0
}

# 创建后台会话
do_tmux_new_session() {
  need_tmux || return 1
  local name
  read -r -p "会话名（默认 main）: " name
  name=${name:-main}
  run tmux new-session -d -s "$name" && echo "${GREEN}✓ 已创建会话: ${name}${NC}"
}

# 在会话中后台发送命令
do_tmux_send_keys() {
  need_tmux || return 1
  local name cmd
  read -r -p "会话名（默认 main）: " name
  name=${name:-main}
  read -r -p "要发送的命令（默认 mkdir demo）: " cmd
  cmd=${cmd:-mkdir demo}
  run tmux send-keys -t "$name" "$cmd" Enter
}

# 列出会话
do_tmux_ls() {
  need_tmux || return 1
  run tmux ls
}

# 连接会话（最近 / 指定）
do_tmux_attach() {
  need_tmux || return 1
  local name
  read -r -p "会话名（留空 = 最近会话）: " name
  if [[ -z "$name" ]]; then
    run tmux attach
  else
    run tmux attach -t "$name"
  fi
}

# 分离会话
do_tmux_detach() {
  need_tmux || return 1
  if [[ -n "${TMUX:-}" ]]; then
    echo "${YELLOW}当前在 tmux 会话内，执行 detach 分离${NC}"
    run tmux detach
  else
    echo "${YELLOW}当前不在 tmux 会话内，尝试分离所有附加的客户端...${NC}"
    echo "${YELLOW}提示：在 tmux 内分离会话可直接按 Ctrl-b d${NC}"
    run tmux detach-client -a 2>/dev/null || echo "${YELLOW}没有正在附加的客户端${NC}"
  fi
}

# 删除指定会话
do_tmux_kill_session() {
  need_tmux || return 1
  local name
  read -r -p "要删除的会话名: " name
  [[ -z "$name" ]] && return 0
  run tmux kill-session -t "$name"
}

# 删除所有会话
do_tmux_kill_server() {
  need_tmux || return 1
  local ans
  read -r -p "${RED}确认删除所有 tmux 会话？[y/N]: ${NC}" ans
  [[ "$ans" =~ ^[Yy]$ ]] || return 0
  run tmux kill-server
}

# 重命名会话
do_tmux_rename_session() {
  need_tmux || return 1
  local old new
  read -r -p "原会话名: " old
  [[ -z "$old" ]] && return 0
  read -r -p "新会话名: " new
  [[ -z "$new" ]] && return 0
  run tmux rename-session -t "$old" "$new"
}

# ============================================================
# 五、ollama 快捷操作
# ============================================================

need_ollama() {
  if [[ -z "$OLLAMA_OK" ]]; then
    echo "${RED}✗ 未检测到 ollama${NC}"
    install_hint ollama
    return 1
  fi
  return 0
}

# ---- 模型管理 ----
do_ollama_pull() {
  need_ollama || return 1
  local model
  read -r -p "模型名（如 llama3.2）: " model
  [[ -z "$model" ]] && return 0
  run ollama pull "$model"
}

do_ollama_list() {
  need_ollama || return 1
  run ollama list
}

do_ollama_serve() {
  need_ollama || return 1
  echo "${YELLOW}注意：ollama serve 会阻塞当前终端，Ctrl+C 退出${NC}"
  run ollama serve
}

do_ollama_show() {
  need_ollama || return 1
  local model ans
  read -r -p "模型名: " model
  [[ -z "$model" ]] && return 0
  read -r -p "查看完整 Modelfile? [y/N]: " ans
  if [[ "$ans" =~ ^[Yy]$ ]]; then
    run ollama show "$model" --modelfile
  else
    run ollama show "$model"
  fi
}

do_ollama_rm() {
  need_ollama || return 1
  local model
  read -r -p "要删除的模型名: " model
  [[ -z "$model" ]] && return 0
  run ollama rm "$model"
}

do_ollama_cp() {
  need_ollama || return 1
  local src dst
  read -r -p "源模型名: " src
  [[ -z "$src" ]] && return 0
  read -r -p "目标模型名: " dst
  [[ -z "$dst" ]] && return 0
  run ollama cp "$src" "$dst"
}

do_ollama_create() {
  need_ollama || return 1
  local name file
  read -r -p "新模型名: " name
  [[ -z "$name" ]] && return 0
  read -r -p "Modelfile 路径（默认 ./Modelfile）: " file
  file=${file:-./Modelfile}
  file=$(expand_tilde "$file")
  run ollama create "$name" -f "$file"
}

do_ollama_push() {
  need_ollama || return 1
  local model
  read -r -p "要推送的模型名: " model
  [[ -z "$model" ]] && return 0
  run ollama push "$model"
}

# ---- 运行状态 ----
do_ollama_ps() {
  need_ollama || return 1
  run ollama ps
}

do_ollama_stop() {
  need_ollama || return 1
  local model
  read -r -p "要停止的模型名（如 llama3.2）: " model
  [[ -z "$model" ]] && return 0
  run ollama stop "$model"
}

# ---- 运行与交互 ----
do_ollama_run() {
  need_ollama || return 1
  local model mode prompt file img
  read -r -p "模型名（如 llama3.2）: " model
  [[ -z "$model" ]] && return 0
  echo "  1) 交互对话"
  echo "  2) 一次性提问"
  echo "  3) 从文件输入"
  echo "  4) 多模态提问（文本 + 图像）"
  read -r -p "请选择（默认 1）: " mode
  mode=${mode:-1}
  case "$mode" in
    2)
      read -r -p "问题: " prompt
      [[ -z "$prompt" ]] && return 0
      run ollama run "$model" "$prompt"
      ;;
    3)
      read -r -p "输入文件路径: " file
      [[ -z "$file" ]] && return 0
      file=$(expand_tilde "$file")
      if [[ ! -f "$file" ]]; then
        echo "${RED}✗ 文件不存在: ${file}${NC}"
        return 1
      fi
      printf '%s+ ollama run %s < %s%s\n' "$BLUE" "$model" "$file" "$NC"
      ollama run "$model" < "$file"
      ;;
    4)
      read -r -p "文本提示: " prompt
      read -r -p "图像文件路径: " img
      [[ -z "$img" ]] && return 0
      img=$(expand_tilde "$img")
      if [[ ! -f "$img" ]]; then
        echo "${RED}✗ 图像文件不存在: ${img}${NC}"
        return 1
      fi
      run ollama run "$model" "$prompt $img"
      ;;
    *)
      run ollama run "$model"
      ;;
  esac
}

# ============================================================
# 菜单
# ============================================================

container_menu() {
  while true; do
    echo; hr
    echo "${BOLD}容器操作（运行时: ${RT_NAME:-未检测到}）${NC}"
    hr
    echo "${RED}  1) 查看容器列表（运行中 / 含已停止，可选 -a）${NC}"
    echo "${RED}  2) 创建容器并后台保活       (run -d ... sleep infinity)${NC}"
    echo "${RED}  3) 在容器中执行命令         (exec -it <name> <cmd>)${NC}"
    echo "${RED}  4) 进入容器 shell           (exec -it <name> bash/sh)${NC}"
    echo "${RED}  5) 复制文件（本地 ↔ 容器）  (cp)${NC}"
    echo "  6) 删除容器                 (rm / rm -f)"
    echo "  7) 启动容器                 (start)"
    echo "  8) 停止容器                 (stop)"
    echo "  9) 重启容器                 (restart)"
    echo "  10) 查看网络列表            (network ls)"
    echo "  11) 查看网络详情            (network inspect)"
    echo "  12) 查看容器日志            (logs / logs -f)"
    echo "  13) 查看容器进程            (top)"
    echo
    echo "  0) 返回上级"
    read -r -p "请选择: " c
    case "$c" in
      1) do_ps ;;
      2) do_run_keepalive ;;
      3) do_exec_cmd ;;
      4) do_exec_shell ;;
      5) do_cp ;;
      6) do_rm_force ;;
      7) do_start ;;
      8) do_stop ;;
      9) do_restart ;;
      10) do_network_ls ;;
      11) do_network_inspect ;;
      12) do_logs ;;
      13) do_top ;;
      0|q|Q) return 0 ;;
      *) echo "${RED}无效选项${NC}" ;;
    esac
    echo
    read -r -p "按回车继续..." _
  done
}

image_menu() {
  while true; do
    echo; hr
    echo "${BOLD}镜像操作（运行时: ${RT_NAME:-未检测到}）${NC}"
    hr
    echo "  1) 构建镜像                 (build -t <tag> <ctx>)"
    echo "  2) 拉取镜像                 (pull <image>)"
    echo "  3) 推送镜像                 (push <image>)"
    echo "  4) 列出镜像                 (images)"
    echo "  5) 删除镜像                 (rmi / rmi -f)"
    echo "  6) 保存镜像为 tar           (save -o <file.tar> <image>)"
    echo "  7) 从 tar 加载镜像          (load -i <file.tar>)"
    echo
    echo "  0) 返回上级"
    read -r -p "请选择: " c
    case "$c" in
      1) do_build ;;
      2) do_pull ;;
      3) do_push ;;
      4) do_images ;;
      5) do_rmi ;;
      6) do_save ;;
      7) do_load ;;
      0|q|Q) return 0 ;;
      *) echo "${RED}无效选项${NC}" ;;
    esac
    echo
    read -r -p "按回车继续..." _
  done
}

compose_menu() {
  while true; do
    echo; hr
    echo "${BOLD}Compose 操作（命令: ${COMPOSE_NAME:-未检测到}）${NC}"
    echo "${YELLOW}提示：请在包含 compose 文件的目录中执行${NC}"
    hr
    echo "  1) 启动服务                 (start)"
    echo "  2) 停止服务                 (stop)"
    echo "  3) 重启服务                 (restart)"
    echo "  4) 启动所有容器             (up / -d / --force-recreate / --no-recreate)"
    echo "  5) 停止并移除资源           (down)"
    echo "  6) 查看运行中的服务         (ps)"
    echo "  7) 删除容器                 (rm / rm -f)"
    echo "  8) 查看服务网络             (network ls)"
    echo "  9) 查看服务日志             (logs [service] [-f])"
    echo
    echo "  0) 返回上级"
    read -r -p "请选择: " c
    case "$c" in
      1) do_compose_start ;;
      2) do_compose_stop ;;
      3) do_compose_restart ;;
      4) do_compose_up ;;
      5) do_compose_down ;;
      6) do_compose_ps ;;
      7) do_compose_rm ;;
      8) do_compose_network_ls ;;
      9) do_compose_logs ;;
      0|q|Q) return 0 ;;
      *) echo "${RED}无效选项${NC}" ;;
    esac
    echo
    read -r -p "按回车继续..." _
  done
}

tmux_menu() {
  while true; do
    echo; hr
    echo "${BOLD}tmux 快捷操作（${TMUX_OK:-未检测到 tmux}）${NC}"
    hr
    echo "  1) 创建会话（后台）            (new-session -d -s <name>)"
    echo "  2) 在会话中发送命令            (send-keys -t <name> <cmd> Enter)"
    echo "  3) 列出会话                    (ls)"
    echo "  4) 连接会话                    (attach / attach -t <name>)"
    echo "  5) 分离会话                    (detach / detach-client)"
    echo "  6) 删除指定会话                (kill-session -t <name>)"
    echo "  7) 删除所有会话                (kill-server)"
    echo "  8) 重命名会话                  (rename-session -t <old> <new>)"
    echo
    echo "  0) 返回上级"
    read -r -p "请选择: " c
    case "$c" in
      1) do_tmux_new_session ;;
      2) do_tmux_send_keys ;;
      3) do_tmux_ls ;;
      4) do_tmux_attach ;;
      5) do_tmux_detach ;;
      6) do_tmux_kill_session ;;
      7) do_tmux_kill_server ;;
      8) do_tmux_rename_session ;;
      0|q|Q) return 0 ;;
      *) echo "${RED}无效选项${NC}" ;;
    esac
    echo
    read -r -p "按回车继续..." _
  done
}

ollama_menu() {
  while true; do
    echo; hr
    echo "${BOLD}ollama 快捷操作（${OLLAMA_OK:-未检测到 ollama}）${NC}"
    hr
    echo "${CYAN}── 模型管理 ──${NC}"
    echo "  1) 拉取模型                    (pull <model>)"
    echo "  2) 列出本地模型                (list)"
    echo "  3) 启动服务（阻塞）            (serve)"
    echo "  4) 查看模型信息                (show <model> [--modelfile])"
    echo "  5) 删除模型                    (rm <model>)"
    echo "  6) 复制模型                    (cp <src> <dst>)"
    echo "  7) 从 Modelfile 创建模型       (create <name> -f <file>)"
    echo "  8) 推送模型                    (push <model>)"
    echo "${CYAN}── 运行状态 ──${NC}"
    echo "  9) 查看运行中的模型            (ps)"
    echo "  10) 停止指定模型               (stop <model>)"
    echo "${CYAN}── 运行与交互 ──${NC}"
    echo "  11) 运行模型（交互/一次性/文件/多模态）(run <model> ...)"
    echo
    echo "  0) 返回上级"
    read -r -p "请选择: " c
    case "$c" in
      1) do_ollama_pull ;;
      2) do_ollama_list ;;
      3) do_ollama_serve ;;
      4) do_ollama_show ;;
      5) do_ollama_rm ;;
      6) do_ollama_cp ;;
      7) do_ollama_create ;;
      8) do_ollama_push ;;
      9) do_ollama_ps ;;
      10) do_ollama_stop ;;
      11) do_ollama_run ;;
      0|q|Q) return 0 ;;
      *) echo "${RED}无效选项${NC}" ;;
    esac
    echo
    read -r -p "按回车继续..." _
  done
}

main_menu() {
  while true; do
    echo; hr
    echo "${BOLD}Docker/Podman 开发工具箱${NC}"
    hr
    echo "  运行时: ${GREEN}${RT_NAME:-未检测到}${NC}    Compose: ${GREEN}${COMPOSE_NAME:-未检测到}${NC}"
    echo "  tmux:   ${GREEN}${TMUX_OK:-未检测到}${NC}    ollama:  ${GREEN}${OLLAMA_OK:-未检测到}${NC}"
    hr
    echo "1) 容器操作      (ps / run / exec / cp / rm / start / stop / restart / network / logs / top)"
    echo "2) 镜像操作      (build / pull / push / images / rmi / save / load)"
    echo "3) Compose 操作  (start / stop / restart / up / down / ps / rm / logs)"
    echo "4) tmux 快捷操作 (new-session / send-keys / ls / attach / detach / kill / rename)"
    echo "5) ollama 快捷操作(pull / list / serve / show / rm / cp / create / push / ps / stop / run)"
    echo "6) 重新检测运行时和外部命令"
    echo "0) 退出"
    read -r -p "请选择: " choice
    case "$choice" in
      1) container_menu ;;
      2) image_menu ;;
      3) compose_menu ;;
      4) tmux_menu ;;
      5) ollama_menu ;;
      6) preflight_check ;;
      0|q|Q)
        echo "Bye."
        if is_sourced; then
          return 0
        else
          exit 0
        fi
        ;;
      *) echo "${RED}无效选项${NC}" ;;
    esac
  done
}

# ---------------- 入口 ----------------
preflight_check
main_menu