#!/usr/bin/env bash
#
# tool —— 开发环境检查 & Git 交互式小工具
#
# 放置于 ~/.local/bin/ 并赋予可执行权限即可作为命令使用
#
# 希望退出 tool 后 shell 仍停在「快速找到 git 项目」所选目录时：
#   方式A（推荐）：source tool   （或 . tool）
#   方式B：直接执行 tool，选中项目后按提示进入新子 shell，exit 后回原 shell
#
# 仅在直接执行时开启严格模式，避免 source 时污染调用方 shell
if [[ "${BASH_SOURCE[0]:-$0}" == "$0" ]]; then
  set -u
fi

# ---------------- 颜色 ----------------
if [[ -t 1 ]]; then
  RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'
  BLUE=$'\033[34m'; CYAN=$'\033[36m'; BOLD=$'\033[1m'; NC=$'\033[0m'
else
  RED=''; GREEN=''; YELLOW=''; BLUE=''; CYAN=''; BOLD=''; NC=''
fi

have() { command -v "$1" >/dev/null 2>&1; }

is_sourced() { [[ "${BASH_SOURCE[0]:-$0}" != "$0" ]]; }

hr() { printf '%s\n' "${CYAN}------------------------------------------------------------${NC}"; }

run() {
  printf '%s+ %s%s\n' "$BLUE" "$*" "$NC"
  "$@"
}

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# 把开头是 ~ 的路径展开为 $HOME（read 不会自动展开）
expand_tilde() {
  local p="$1"
  if [[ "$p" == "~" ]]; then
    printf '%s' "$HOME"
  elif [[ "$p" == "~/"* ]]; then
    printf '%s' "${HOME}/${p#\~/}"
  else
    printf '%s' "$p"
  fi
}

# ---------------- 安装提示 ----------------
install_hint() {
  case "$1" in
    git)      echo "  git      : sudo apt install git / sudo dnf install git / brew install git" ;;
    gh)       echo "  gh       : https://cli.github.com/  （brew install gh / sudo apt install gh）" ;;
    glab)     echo "  glab     : https://gitlab.com/gitlab-org/cli  （brew install glab）" ;;
    claude)   echo "  claude   : npm i -g @anthropic-ai/claude-code" ;;
    opencode) echo "  opencode : 参考 https://opencode.ai/docs 安装" ;;
    codex)    echo "  codex    : npm i -g @openai/codex" ;;
    fzf)      echo "  fzf      : sudo apt install fzf / sudo dnf install fzf / brew install fzf" ;;
    rclone)   echo "  rclone   : curl https://rclone.org/install.sh | sudo bash / brew install rclone / sudo apt install rclone" ;;
    restic)   echo "  restic   : sudo apt install restic / sudo dnf install restic / brew install restic（或 https://github.com/restic/restic/releases 下载静态二进制）" ;;
    dsh)      echo "  dsh      : npx @deepseek-ai/dsh web  或  npm i -g @deepseek-ai/dsh" ;;
    rea)      echo "  rea      : npx rea-agents setup  或  npm i -g rea-agents" ;;
    *)        echo "  $1       : 请自行安装" ;;
  esac
}

# 检查一组命令，缺任意一个就提示安装并返回 1
need_tools() {
  local missing=() t
  for t in "$@"; do
    have "$t" || missing+=("$t")
  done
  if (( ${#missing[@]} > 0 )); then
    echo "${RED}✗ 缺少命令: ${missing[*]}${NC}"
    echo "${YELLOW}请自行安装后再使用该功能：${NC}"
    for t in "${missing[@]}"; do install_hint "$t"; done
    return 1
  fi
  return 0
}

# ---------------- 启动前自检 ----------------
preflight_check() {
  local tools=(git gh glab claude opencode codex fzf rclone restic)
  local missing=() t
  for t in "${tools[@]}"; do
    have "$t" || missing+=("$t")
  done
  if (( ${#missing[@]} > 0 )); then
    echo "${YELLOW}⚠ 以下命令未安装：${missing[*]}${NC}"
    echo "${YELLOW}相关功能将不可用，请自行安装：${NC}"
    for t in "${missing[@]}"; do install_hint "$t"; done
    echo
  fi
}

