# ---------------- 6. 快速找到所有 git 项目 ----------------
do_find_git_projects() {
  need_tools find fzf || return 1
  local root dir ans
  read -r -p "搜索根目录（留空则搜索全部目录 /，可能较慢）: " root
  root=${root:-/}

  echo "${CYAN}正在搜索 ${root} 下的 git 项目（要求含 README.md）...${NC}"
  dir=$(find "$root" -name .git 2>/dev/null \
    | sed 's|/\.git$||' \
    | while IFS= read -r d; do
        [ -f "$d/README.md" ] && echo "$d"
      done \
    | sort -u \
    | fzf --prompt="选择 git 项目 > ")

  if [[ -z "$dir" ]]; then
    echo "${YELLOW}未选择或未找到符合条件的项目（需要含 README.md）${NC}"
    return 0
  fi

  if is_sourced; then
    cd "$dir" || return 1
    echo "${GREEN}✓ 当前 shell 已切换到: $(pwd)${NC}"
    read -r -p "是否进入 Git 交互式操作菜单? [y/N]: " ans
    if [[ "$ans" =~ ^[Yy]$ ]]; then
      git_menu
    fi
  else
    echo "${CYAN}目标目录: $dir${NC}"
    read -r -p "是否进入该目录的新 shell?（exit 后回原 shell）[Y/n]: " ans
    if [[ ! "$ans" =~ ^[Nn]$ ]]; then
      cd "$dir" || return 1
      echo "${GREEN}✓ 进入新 shell: $(pwd)（输入 exit 返回原 shell）${NC}"
      exec "${SHELL:-bash}" -i
    fi
    echo "${YELLOW}提示：直接执行脚本无法改变父 shell 的目录。${NC}"
    echo "${YELLOW}  手动切换：cd $(printf '%q' "$dir")${NC}"
    echo "${YELLOW}  或改用：  source $0   （让 tool 里的 cd 直接生效）${NC}"
  fi
}

# ---------------- 7. 快速创建 git 项目并跳转 ----------------
do_create_git_project() {
  need_tools git || return 1
  local base="${HOME}/.local/share/devmgr"
  local name dir ans

  read -r -p "项目名（默认 demo）: " name
  name=${name:-demo}

  if [[ "$name" == */* || "$name" == "." || "$name" == ".." ]]; then
    echo "${RED}项目名不能包含 '/' 或为 . / ..${NC}"
    return 1
  fi

  dir="${base}/${name}"
  mkdir -p "$dir" || return 1
  cd "$dir" || return 1

  if [[ -d .git ]]; then
    echo "${YELLOW}已是 git 仓库，跳过 git init${NC}"
  else
    run git init
  fi

  if [[ -f README.md ]]; then
    echo "${YELLOW}README.md 已存在，跳过创建${NC}"
  else
    echo > README.md
    echo "${GREEN}✓ 已创建 README.md${NC}"
  fi

  echo "${GREEN}✓ 项目目录: $(pwd)${NC}"

  if is_sourced; then
    read -r -p "是否进入 Git 交互式操作菜单? [y/N]: " ans
    if [[ "$ans" =~ ^[Yy]$ ]]; then
      git_menu
    fi
  else
    read -r -p "是否进入该目录的新 shell?（exit 后回原 shell）[Y/n]: " ans
    if [[ ! "$ans" =~ ^[Nn]$ ]]; then
      echo "${GREEN}✓ 进入新 shell: $(pwd)（输入 exit 返回原 shell）${NC}"
      exec "${SHELL:-bash}" -i
    fi
    echo "${YELLOW}提示：直接执行脚本无法改变父 shell 的目录。${NC}"
    echo "${YELLOW}  手动切换：cd $(printf '%q' "$dir")${NC}"
    echo "${YELLOW}  或改用：  source $0   （让 tool 里的 cd 直接生效）${NC}"
  fi
}

# ---------------- 8. gh 仓库 / 星标 / Release 管理 ----------------

# 询问目标仓库（优先当前仓库），结果写到 stdout
ask_gh_repo() {
  local repo="" input
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    repo=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)
  fi
  if [[ -n "$repo" ]]; then
    read -r -p "目标仓库 [默认 ${repo}，回车沿用当前仓库]: " input
    [[ -n "$input" ]] && repo="$input"
  else
    read -r -p "目标仓库（owner/repo，必填）: " input
    repo="$input"
  fi
  printf '%s' "$repo"
}

# 查看自己（或指定用户）的仓库列表
do_gh_repo_list() {
  need_tools gh || return 1
  local user limit
  local -a cmd=(gh repo list)
  read -r -p "用户名（留空 = 你自己）: " user
  read -r -p "数量上限（0 = 全部，默认 30）: " limit
  limit=${limit:-30}
  [[ -n "$user" ]] && cmd+=("$user")
  cmd+=(--limit "$limit")
  echo "${CYAN}>>> ${cmd[*]}${NC}"
  "${cmd[@]}" || true
}

# 查看已星标集合（GitHub Lists）名称
do_gh_starred_lists() {
  need_tools gh || return 1
  local q='{ viewer { lists(first: 100) { nodes { name } } } }'
  local jq='.data.viewer.lists.nodes[].name'
  echo "${CYAN}>>> gh api graphql -f query='${q}' --jq '${jq}'${NC}"
  gh api graphql -f query="$q" --jq "$jq" || true
}

# 查看某个星标集合里的项目
do_gh_starred_list_items() {
  need_tools gh || return 1
  local list jq
  read -r -p "星标集合名称（如 game）: " list
  [[ -z "$list" ]] && return 0

  local q='
query {
  viewer {
    lists(first: 100) {
      nodes {
        name
        items(first: 100) {
          nodes {
            ... on Repository {
              nameWithOwner
            }
          }
        }
      }
    }
  }
}'
  jq=".data.viewer.lists.nodes[] | select(.name == \"${list}\") | .items.nodes[].nameWithOwner"
  echo "${CYAN}>>> gh api graphql -f query='{...}' --jq \"${jq}\"${NC}"
  gh api graphql -f query="$q" --jq "$jq" || true
}

