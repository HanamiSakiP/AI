# ---------------- 9. rclone 快捷操作 ----------------

rclone_login_help() {
  hr
  echo "${BOLD}rclone 登录配置指引${NC}"
  hr
  cat <<'EOF'
【以 Dropbox 为例】
  1) 运行 rclone config
  2) 输入 n 新建 remote
  3) 输入名字（例如 k）
  4) 选择服务类型 dropbox（输入对应编号或 dropbox）
  5) client_id、client_secret 直接回车（使用默认）
  6) 是否编辑高级配置：n
  7) 是否自动配置（浏览器 OAuth）：y
  8) 浏览器打开授权页面，登录 Dropbox 并允许授权
  9) 回到终端确认 y，完成配置

【其它常见服务】
  Google Drive    → drive
  OneDrive        → onedrive
  S3 兼容（R2/B2）→ s3
  WebDAV（坚果云）→ webdav
  SFTP            → sftp

【常用命令】
  rclone listremotes              列出所有 remote
  rclone ls  <remote>:<path>      列出文件（含大小）
  rclone lsd <remote>:<path>      仅列目录
  rclone lsf <remote>:<path>      简洁列表（脚本友好）
  rclone copy <src> <dst>         复制（不删除目标多余文件）
  rclone sync <src> <dst>         同步（会删除目标多余文件，危险，务必先 --dry-run）
EOF
}

do_rclone_config() {
  need_tools rclone || return 1
  run rclone config
}

do_rclone_listremotes() {
  need_tools rclone || return 1
  run rclone listremotes
}

do_rclone_ls() {
  need_tools rclone || return 1
  local remote path mode target
  read -r -p "remote 名（默认 k）: " remote
  remote=${remote:-k}
  read -r -p "路径（默认 backups）: " path
  path=${path:-backups}
  read -r -p "模式 [1=ls 文件 2=lsd 仅目录 3=lsf 简洁]（默认 1）: " mode

  target="${remote}:${path}"
  case "$mode" in
    2) run rclone lsd "$target" ;;
    3) run rclone lsf "$target" ;;
    *) run rclone ls "$target" ;;
  esac
}

do_rclone_copy() {
  need_tools rclone || return 1
  local src dst
  read -r -p "源（默认 k:backups）: " src
  src=${src:-k:backups}
  read -r -p "目标（默认 ~/.local/share/devmgr/）: " dst
  dst=${dst:-~/.local/share/devmgr/}
  dst=$(expand_tilde "$dst")
  run rclone copy "$src" "$dst" --progress
}

do_rclone_sync() {
  need_tools rclone || return 1
  local src dst ans
  read -r -p "源（默认 ~/.local/share/devmgr/）: " src
  src=${src:-~/.local/share/devmgr/}
  src=$(expand_tilde "$src")
  read -r -p "目标（默认 k:backups）: " dst
  dst=${dst:-k:backups}
  read -r -p "是否执行真实同步（会删除目标多余文件！）[y/N]: " ans

  local cmd=(rclone sync "$src" "$dst" --progress)
  if [[ ! "$ans" =~ ^[Yy]$ ]]; then
    cmd+=(--dry-run)
    echo "${YELLOW}已启用 --dry-run 模拟执行${NC}"
  fi
  echo "${CYAN}>>> ${cmd[*]}${NC}"
  "${cmd[@]}"
}

# ---------------- restic 快捷操作 ----------------
# 默认 restic 仓库与默认备份源目录，可通过环境变量覆盖
RESTIC_REPO="${RESTIC_REPO:-$HOME/.local/share/devmgr/restic}"
RESTIC_BACKUP_DIR="${RESTIC_BACKUP_DIR:-$HOME/.local/share/devmgr/backups}"

# 每次操作前询问仓库路径，回车使用默认 RESTIC_REPO
ask_restic_repo() {
  local repo
  read -r -p "restic 仓库路径（默认 ${RESTIC_REPO}，回车沿用）: " repo
  repo=${repo:-$RESTIC_REPO}
  repo=$(expand_tilde "$repo")
  printf '%s' "$repo"
}

do_restic_init() {
  need_tools restic || return 1
  local repo
  repo=$(ask_restic_repo)
  if [[ -d "$repo" ]]; then
    echo "${YELLOW}restic 仓库已存在: $repo${NC}"
    return 0
  fi
  run restic -r "$repo" init
}

do_restic_snapshots() {
  need_tools restic || return 1
  local repo
  repo=$(ask_restic_repo)
  run restic -r "$repo" snapshots
}

do_restic_ls() {
  need_tools restic || return 1
  local repo id
  repo=$(ask_restic_repo)
  read -r -p "快照 ID（留空 = latest）: " id
  id=${id:-latest}
  run restic -r "$repo" ls "$id"
}

do_restic_ls_path() {
  need_tools restic || return 1
  local repo id path
  repo=$(ask_restic_repo)
  read -r -p "快照 ID（留空 = latest）: " id
  id=${id:-latest}
  read -r -p "路径（例如 backups/g，留空 = 全部）: " path
  if [[ -n "$path" ]]; then
    run restic -r "$repo" ls "$id" --path "$path"
  else
    run restic -r "$repo" ls "$id"
  fi
}

do_restic_restore_include() {
  need_tools restic || return 1
  local repo id target include
  repo=$(ask_restic_repo)
  read -r -p "快照 ID（留空 = latest）: " id
  id=${id:-latest}
  read -r -p "恢复目标目录（--target，默认 restore）: " target
  target=${target:-restore}
  read -r -p "包含路径（--include，默认 ${RESTIC_BACKUP_DIR}）: " include
  include=${include:-$RESTIC_BACKUP_DIR}
  include=$(expand_tilde "$include")
  run restic -r "$repo" restore "$id" --target "$target" --include "$include"
}

do_restic_restore_all() {
  need_tools restic || return 1
  local repo id target
  repo=$(ask_restic_repo)
  read -r -p "快照 ID（留空 = latest）: " id
  id=${id:-latest}
  read -r -p "恢复目标目录（--target，默认 restore）: " target
  target=${target:-restore}
  run restic -r "$repo" restore "$id" --target "$target"
}

do_restic_backup() {
  need_tools restic || return 1
  local repo path
  repo=$(ask_restic_repo)
  read -r -p "要备份的路径（默认 ${RESTIC_BACKUP_DIR}）: " path
  path=${path:-$RESTIC_BACKUP_DIR}
  path=$(expand_tilde "$path")
  run restic -r "$repo" backup "$path"
}

