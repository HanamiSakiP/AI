  hr
  echo "${BOLD}Git 远程仓库登录状态${NC}"
  hr

  echo "${CYAN}[gh] GitHub CLI${NC}"
  if have gh; then
    if gh auth status 2>&1; then
      echo "${GREEN}✓ gh 已登录${NC}"
    else
      echo "${YELLOW}✗ gh 未登录，请运行: gh auth login${NC}"
    fi
  else
    echo "${RED}✗ 未安装 gh${NC}"; install_hint gh
  fi

  echo
  echo "${CYAN}[glab] GitLab CLI${NC}"
  if have glab; then
    if glab auth status 2>&1; then
      echo "${GREEN}✓ glab 已登录${NC}"
