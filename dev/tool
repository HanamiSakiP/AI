# ---------------- 4. Git 交互式操作 ----------------

do_git_init() {
  need_tools git || return 1
  if [[ -d .git ]]; then
    echo "${YELLOW}当前目录已经是 git 仓库，无需初始化${NC}"
    return 0
  fi
  run git init
}

do_gh_create_clone() {
  need_tools git gh || return 1
  local name vis
  read -r -p "新仓库名（例如 my-project）: " name
  [[ -z "$name" ]] && return 0
  read -r -p "可见性 [private/public]（默认 private）: " vis
  vis=$(lower "${vis:-private}")
  [[ "$vis" != "private" && "$vis" != "public" ]] && vis="private"
  run gh repo create "$name" "--$vis" --clone
}

do_gh_create_template() {
  need_tools git gh || return 1
  local name tpl vis
  read -r -p "新仓库名（例如 my-new-repo）: " name
  [[ -z "$name" ]] && return 0
  read -r -p "模板仓库 owner/template-repo: " tpl
  [[ -z "$tpl" ]] && return 0
  read -r -p "可见性 [private/public]（默认 public）: " vis
  vis=$(lower "${vis:-public}")
  [[ "$vis" != "private" && "$vis" != "public" ]] && vis="public"
  run gh repo create "$name" --template "$tpl" "--$vis" --clone
}

do_commit_push() {
  need_tools git || return 1
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "${RED}当前目录不是 git 仓库${NC}"
    return 1
  fi

  echo "${CYAN}--- 当前分支 ---${NC}"
  git branch -vv 2>&1 || true
  echo "${CYAN}--- 当前远程仓库 ---${NC}"
  git remote -v 2>&1 || true

  local ans
  read -r -p "是否将当前分支重命名/切换为 main? [y/N]: " ans
  if [[ "$ans" =~ ^[Yy]$ ]]; then
    run git branch -M main
  fi

  local msg
  read -r -p "提交信息（默认 first commit）: " msg
  msg=${msg:-first commit}

  run git add .
  if ! run git commit -m "$msg"; then
    echo "${YELLOW}没有可提交的更改或提交失败（可忽略继续推送）${NC}"
  fi

  read -r -p "是否推送? [Y/n]: " ans
  if [[ "$ans" =~ ^[Nn]$ ]]; then
    return 0
  fi

  if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    run git push
  else
    echo "${YELLOW}当前分支没有 upstream${NC}"
    read -r -p "是否执行 git push -u origin main? [Y/n]: " ans
    if [[ ! "$ans" =~ ^[Nn]$ ]]; then
      run git push -u origin main
    fi
  fi
}

do_remote_add() {
  need_tools git || return 1
  local url ans
  read -r -p "远程仓库地址（如 git@github.com:user/repo.git）: " url
  [[ -z "$url" ]] && return 0

  if git remote get-url origin >/dev/null 2>&1; then
    echo "${YELLOW}origin 已存在: $(git remote get-url origin)${NC}"
    read -r -p "是否替换为新的地址? [y/N]: " ans
    [[ "$ans" =~ ^[Yy]$ ]] || return 0
    run git remote set-url origin "$url"
  else
    run git remote add origin "$url"
  fi

  echo "${CYAN}提示：首次推送可用：git push -u origin main${NC}"
}

do_gh_create_push() {
  need_tools git gh || return 1
  local name vis
  read -r -p "仓库名（例如 docs）: " name
  [[ -z "$name" ]] && return 0
  read -r -p "可见性 [private/public]（默认 public）: " vis
  vis=$(lower "${vis:-public}")
  [[ "$vis" != "private" && "$vis" != "public" ]] && vis="public"
  run gh repo create "$name" "--$vis" --source=. --push
}

do_git_clone() {
  need_tools git || return 1
  local url dir
  read -r -p "远程仓库地址（如 https://github.com/HanamiSakiP/AI.git）: " url
  [[ -z "$url" ]] && return 0
  read -r -p "本地目录名（留空则使用仓库名）: " dir
  if [[ -n "$dir" ]]; then
    run git clone "$url" "$dir"
  else
    run git clone "$url"
  fi
}

do_gh_repo_clone() {
  need_tools git gh || return 1
  local repo dir
  read -r -p "仓库（如 HanamiSakiP/AI 或 owner/repo）: " repo
  [[ -z "$repo" ]] && return 0
  read -r -p "本地目录名（留空则使用仓库名）: " dir
  if [[ -n "$dir" ]]; then
    run gh repo clone "$repo" "$dir"
  else
    run gh repo clone "$repo"
  fi
}

do_git_update() {
  need_tools git || return 1
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "${RED}当前目录不是 git 仓库${NC}"
    return 1
  fi

  echo "${CYAN}--- 当前分支 ---${NC}"
  git branch -vv 2>&1 || true

  echo
  echo "${CYAN}>>> git pull${NC}"
  run git pull

  echo
  echo "${CYAN}>>> git submodule update --init --recursive${NC}"
  run git submodule update --init --recursive

  echo "${GREEN}✓ 更新完成${NC}"
}

git_menu() {
  while true; do
    echo
    hr
    echo "${BOLD}Git 交互式操作${NC}"
    hr
    echo "  ${GREEN}情况1：尚未创建本地/远程仓库${NC}"
    echo "   1) 初始化本地仓库            (git init)"
    echo "   2) 创建 GitHub 仓库并克隆    (gh repo create --clone)"
    echo "   3) 基于模板创建仓库并克隆    (gh repo create --template ... --clone)"
    echo
    echo "  ${GREEN}通用：提交更改${NC}"
    echo "   4) 查看分支/远程 → add → commit → push"
    echo
    echo "  ${GREEN}情况2：已有本地仓库，推送到远程${NC}"
    echo "   5) 添加远程仓库 origin       (git remote add origin ...)"
    echo "   6) 用 gh 从当前目录创建并推送 (gh repo create --source=. --push)"
    echo
    echo "  ${GREEN}情况3：已有远程仓库，下载到本地${NC}"
    echo "   7) 使用 git clone 下载       (git clone <url>)"
    echo "   8) 使用 gh repo clone 下载   (gh repo clone owner/repo)"
    echo
    echo "  ${GREEN}通用：更新已有仓库${NC}"
    echo "   9) 更新 git 项目             (git pull + 子模块递归更新)"
    echo
    echo "   ${RED}10) 快速创建 git 项目并跳转  (~/.local/share/devmgr/<name>)${NC}"
    echo "   ${RED}11) gh 查看 / 下载 Release${NC}"
    echo
    echo "   0) 返回上级"
    read -r -p "请选择: " c
    case "$c" in
      1) do_git_init ;;
      2) do_gh_create_clone ;;
      3) do_gh_create_template ;;
      4) do_commit_push ;;
      5) do_remote_add ;;
      6) do_gh_create_push ;;
      7) do_git_clone ;;
      8) do_gh_repo_clone ;;
