do_gh_release_view() {
  need_tools git gh || return 1
  local repo tag ans cmd
  repo=$(ask_gh_repo)
  [[ -z "$repo" ]] && return 1
  read -r -p "Tag（留空 = 最新 Release）: " tag
  cmd=(gh release view)
  [[ -n "$tag" ]] && cmd+=("$tag")
  cmd+=(-R "$repo")
  echo "${CYAN}>>> ${cmd[*]}${NC}"
  "${cmd[@]}" || true

  read -r -p "是否在浏览器中打开? [y/N]: " ans
  if [[ "$ans" =~ ^[Yy]$ ]]; then
    cmd+=(--web)
    echo "${CYAN}>>> ${cmd[*]}${NC}"
    "${cmd[@]}" || true
  fi
}

do_gh_release_download() {
  need_tools git gh || return 1
  local repo tag dir clobber use_pattern pattern cmd dl_dir view_tag assets_raw asset
  local -a expected_assets=()
  repo=$(ask_gh_repo)
  [[ -z "$repo" ]] && return 1

  read -r -p "Tag（留空 = 最新 Release）: " tag
  read -r -p "是否按文件名筛选资产（--pattern）? [y/N]: " use_pattern
  pattern=""
  if [[ "$use_pattern" =~ ^[Yy]$ ]]; then
    read -r -p "文件名 glob 模式（如 *.tar.gz，直接回车 = 全部资产）: " pattern
  fi
  read -r -p "下载目录（默认当前目录）: " dir
  read -r -p "覆盖已存在文件（--clobber）? [y/N]: " clobber

  cmd=(gh release download)
  [[ -n "$tag" ]] && cmd+=("$tag")

  if [[ -n "$pattern" ]]; then
    cmd+=(--pattern "$pattern")
  elif [[ -z "$tag" ]]; then
    cmd+=(--pattern '*')
    echo "${YELLOW}提示：下载最新 Release 时 gh 要求必须指定 --pattern，已自动使用 '*'（匹配全部资产）${NC}"
  fi

  [[ -n "$dir" ]] && cmd+=(--dir "$dir")
  [[ "$clobber" =~ ^[Yy]$ ]] && cmd+=(--clobber)
  cmd+=(-R "$repo")

  dl_dir="${dir:-.}"
  view_tag="$tag"
  if [[ -z "$view_tag" ]]; then
    view_tag=$(gh release view -R "$repo" --json tagName -q .tagName 2>/dev/null || true)
  fi
  if [[ -n "$view_tag" ]]; then
    assets_raw=$(gh release view "$view_tag" -R "$repo" --json assets -q '.assets[].name' 2>/dev/null || true)
    if [[ -n "$assets_raw" ]]; then
      while IFS= read -r asset; do
        [[ -z "$asset" ]] && continue
        if [[ -n "$pattern" ]]; then
          # shellcheck disable=SC2053
          if [[ "$asset" == $pattern ]]; then
            expected_assets+=("$asset")
          fi
        else
          expected_assets+=("$asset")
        fi
      done <<< "$assets_raw"
    fi
  fi

  echo "${CYAN}>>> ${cmd[*]}${NC}"
  if "${cmd[@]}"; then
    echo
    echo "${GREEN}✓✓✓ 下载成功 ✓✓✓${NC}"
    local abs_dir
    abs_dir=$(cd "$dl_dir" 2>/dev/null && pwd) || abs_dir="$dl_dir"
    echo "下载目录: ${abs_dir}"
    echo "本次下载文件:"
    local found_any=0
    if (( ${#expected_assets[@]} > 0 )); then
      local f line
      for asset in "${expected_assets[@]}"; do
        f="${dl_dir}/${asset}"
        if [[ -f "$f" ]]; then
          while IFS= read -r line; do
            printf '%s%s%s\n' "${RED}" "$line" "${NC}"
          done < <(ls -lh "$f")
          found_any=1
        fi
      done
    fi
    if (( found_any == 0 )); then
      if [[ -n "$pattern" ]]; then
        while IFS= read -r f; do
          [[ -z "$f" ]] && continue
          while IFS= read -r line; do
            printf '%s%s%s\n' "${RED}" "$line" "${NC}"
          done < <(ls -lh "$f")
        done < <(find "$dl_dir" -maxdepth 1 -type f -name "$pattern" 2>/dev/null)
      else
        while IFS= read -r line; do
          printf '%s%s%s\n' "${RED}" "$line" "${NC}"
        done < <(ls -lh "$dl_dir" 2>/dev/null)
      fi
    fi
  else
    echo
    echo "${RED}✗✗✗ 下载失败！${NC}"
    echo "${YELLOW}请检查：Tag 是否存在 / pattern 是否匹配 / 网络与权限${NC}"
  fi
}

do_gh_repo_menu() {
  need_tools git gh || return 1
  while true; do
