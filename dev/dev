# ================================================================
# 主入口
# ================================================================
main() {
    local cmd="${1:-}"
    [ "$#" -gt 0 ] && shift

    case "$cmd" in
        install|i)         cmd_install  "$@" ;;
        backup|b)          cmd_backup   "$@" ;;
        restore|r|recover) cmd_restore  "$@" ;;
        status|st|s)       cmd_status   "$@" ;;
        list|ls|l)         cmd_list     "$@" ;;
        self-install|deploy) cmd_self_install "$@" ;;
        help|-h|--help)    show_help ;;
        version|-v|--version) printf '%s %s\n' "$PROG_NAME" "$VERSION" ;;
        "")
            show_help
            return 1
            ;;
        *)
            log_error "未知命令: $cmd"
            show_help
            return 1
            ;;
    esac
}

main "$@"